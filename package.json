{
  "name": "brokey",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run scripts/embed-migrations.ts && bun build src/index.ts --compile --outfile dist/brokey",
    "db:generate": "drizzle-kit generate && bun run scripts/embed-migrations.ts",
    "fmt": "bun fmt",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "1.0.0-rc.5",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "^7"
  }
}
