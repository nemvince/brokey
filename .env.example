ADMIN_TOKEN=change-me-to-a-long-random-token
DATABASE_PATH=./data/brokey.db
PORT=3000

# OpenCode free provider (all optional; defaults shown)
# BROKEY_OPENCODE_CATALOG_URL=https://models.opencode.ai/api.json
# BROKEY_OPENCODE_UPDATE_API=https://opencode.ai/update/api
# BROKEY_OPENCODE_SOURCE_BASE=https://raw.githubusercontent.com/anomalyco/opencode
# BROKEY_OPENCODE_ATOM_URL=https://github.com/anomalyco/opencode/releases.atom
# BROKEY_OPENCODE_CHANNEL=latest
# BROKEY_OPENCODE_UPDATE_MODE=reactive        # or "always"
# BROKEY_OPENCODE_USER_AGENT=                 # set to pin the identity, disabling sync
# BROKEY_OPENCODE_CHAT_URL=                   # set to pin the inference endpoint
